APP_NAME=lokigi-google-oauth
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lokigi

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_TOKEN_ENCRYPTION_KEY=replace_with_fernet_key
OAUTH_STATE_SECRET=replace_with_strong_random_secret

GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# Audience configured in Pub/Sub push subscription
GOOGLE_PUBSUB_AUDIENCE=replace_with_pubsub_audience

# Comma-separated hosts accepted by TrustedHostMiddleware (example: api.example.com,localhost)
ALLOWED_HOSTS=*

# Optional defense-in-depth shared secret for webhook endpoint header X-Webhook-Secret
WEBHOOK_SHARED_SECRET=

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Public hostname used by Caddy and by Google OAuth redirect/webhook configuration
APP_DOMAIN=api.example.com
LETSENCRYPT_EMAIL=ops@example.com

# SendGrid (leave blank to disable report emails)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@lokigi.com
