{
    email {$LETSENCRYPT_EMAIL}
}

{$APP_DOMAIN} {
    encode gzip

    @webhook path /webhooks/google/reviews
    handle @webhook {
        reverse_proxy api:8000
    }

    @oauth path /oauth/google/*
    handle @oauth {
        reverse_proxy api:8000
    }

    @health path /health
    handle @health {
        reverse_proxy api:8000
    }

    respond "not found" 404
}
