<!DOCTYPE html>
<html lang="es" data-org-id="{{ theme.org_id or '' }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{% block title %}Panel{% endblock %} · {{ theme.agency_name }}</title>

  {# ── Favicon: use org logo if available, else default Lokigi icon ── #}
  {% if theme.favicon_url %}
  <link rel="icon" type="image/png" href="{{ theme.favicon_url | e }}" />
  {% else %}
  <link rel="icon" href="/static/img/lokigi-favicon.png" />
  {% endif %}

  {# ── Google Fonts (brand font per theme) ── #}
  {% set google_font = theme.font_family.split(",")[0].strip().replace("'", "").replace('"', '') %}
  {% if google_font not in ("Arial", "Helvetica Neue", "sans-serif") %}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family={{ google_font | replace(' ', '+') }}:wght@400;500;600;700;800&display=swap"
        rel="stylesheet" />
  {% endif %}

  {# ── Tailwind CDN (development) / or <link> to compiled CSS in production ── #}
  <script src="https://cdn.tailwindcss.com"></script>

  {# ── CSS custom properties injected from the database ── #}
  <style>
    /*
     * Lokigi Enterprise — Dynamic Brand Theme
     * Values come from organizations.primary_color / secondary_color / font_family
     * resolved by ThemeService → ThemeMiddleware → Jinja2 context.
     *
     * Usage in templates:
     *   bg-[--color-primary]        (Tailwind arbitrary value syntax)
     *   color: var(--color-primary) (plain CSS)
     */
    :root {
      --color-primary:           {{ theme.primary_color }};
      --color-primary-hover:     {{ theme.primary_color }}cc;   /* 80% opacity */
      --color-secondary:         {{ theme.secondary_color }};
      --color-secondary-hover:   {{ theme.secondary_color }}cc;
      --font-brand:              {{ theme.font_family }};

      /* Derived surface colors (dark-mode enterprise palette) */
      --bg-base:     #0c0a09;   /* stone-950 */
      --bg-card:     rgba(255,255,255,.04);
      --bg-card-hover: rgba(255,255,255,.07);
      --border-muted: rgba(255,255,255,.10);
      --text-primary: #f1f5f9;
      --text-muted:   #78716c;
    }

    body {
      font-family: var(--font-brand), Arial, "Helvetica Neue", sans-serif;
      background: var(--bg-base);
      color: var(--text-primary);
    }

    /* ── Brand-colored interactive elements ── */
    .btn-brand {
      background: var(--color-primary);
      color: #fff;
      border-radius: 12px;
      padding: 10px 22px;
      font-weight: 700;
      font-size: 14px;
      border: none;
      cursor: pointer;
      transition: background .15s;
    }
    .btn-brand:hover { background: var(--color-primary-hover); }

    .btn-brand-outline {
      background: transparent;
      color: var(--color-primary);
      border: 1.5px solid var(--color-primary);
      border-radius: 12px;
      padding: 9px 21px;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      transition: background .15s, color .15s;
    }
    .btn-brand-outline:hover {
      background: var(--color-primary);
      color: #fff;
    }

    .text-brand        { color: var(--color-primary); }
    .text-brand-sec    { color: var(--color-secondary); }
    .bg-brand          { background: var(--color-primary); }
    .bg-brand-subtle   { background: color-mix(in srgb, var(--color-primary) 12%, transparent); }
    .border-brand      { border-color: var(--color-primary); }
    .ring-brand        { outline: 2px solid var(--color-primary); }

    /* ── Navbar brand accent ── */
    .nav-brand-badge {
      background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    }

    /* ── Progress / bar fills ── */
    .fill-brand {
      background: linear-gradient(90deg, var(--color-primary), var(--color-secondary));
    }

    /* ── Active nav item ── */
    .nav-active {
      background: color-mix(in srgb, var(--color-primary) 18%, transparent);
      color: var(--color-primary);
      border: 1px solid color-mix(in srgb, var(--color-primary) 30%, transparent);
    }

    /* ── Animations (unchanged across themes) ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .fade-up { animation: fadeUp .35s ease both; }

    @keyframes pulse-dot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50%       { opacity: .4; transform: scale(1.5); }
    }
    .pulse { animation: pulse-dot 1.4s ease-in-out infinite; }
  </style>

  {% block head_extra %}{% endblock %}
</head>

<body class="min-h-screen bg-[--bg-base] text-[--text-primary]">

  {# ════════════════════════════════════════════════════════════════════
     NAVBAR
     Shows the org's logo if one is configured; falls back to the
     agency_name text badge in the brand color.
  ════════════════════════════════════════════════════════════════════ #}
  <nav class="sticky top-0 z-50 flex items-center gap-2 px-5 h-14
              border-b border-[--border-muted] shadow-sm
              bg-[--bg-base]/95 backdrop-blur-sm">

    {# Logo / wordmark #}
    <a href="{{ url_for('enterprise_hub') if url_for is defined else '/' }}"
       class="flex items-center gap-2.5 mr-4 no-underline">
      {% if theme.logo_url %}
        <img src="{{ theme.logo_url | e }}"
             alt="{{ theme.agency_name | e }}"
             class="h-8 w-auto object-contain" />
      {% else %}
        <span class="nav-brand-badge w-8 h-8 rounded-lg flex items-center justify-center
                     text-white font-black text-sm">
          {{ (theme.agency_name[0] | upper) if theme.agency_name else "L" }}
        </span>
        <span class="font-bold text-white text-[15px]">{{ theme.agency_name }}</span>
      {% endif %}
    </a>

    {# Powered-by Lokigi tag (only if not fully white-labelled) #}
    {% if not theme.hide_lokigi_brand %}
    <span class="hidden sm:inline-flex px-2.5 py-0.5 rounded-full
                 bg-[--bg-card] border border-[--border-muted]
                 text-[11px] text-[--text-muted] font-medium">
      powered by Lokigi
    </span>
    {% endif %}

    {# Primary nav links — override per section #}
    <div class="flex items-center gap-1 ml-auto flex-wrap">
      {% block nav_links %}{% endblock %}
    </div>

    {# User avatar / logout #}
    <div class="ml-3 flex items-center gap-2">
      {% block nav_user %}
      <div class="w-8 h-8 rounded-full bg-brand-subtle border border-[--border-muted]
                  flex items-center justify-center text-xs font-bold text-brand">
        {{ request.state.user_initials | default("?") }}
      </div>
      {% endblock %}
    </div>
  </nav>

  {# ════════════════════════════════════════════════════════════════════
     FLASH MESSAGES
  ════════════════════════════════════════════════════════════════════ #}
  {% with messages = get_flashed_messages(with_categories=true) if get_flashed_messages is defined else [] %}
    {% if messages %}
    <div class="fixed top-14 left-0 right-0 z-40 flex flex-col gap-2 px-4 py-2">
      {% for category, message in messages %}
      <div class="mx-auto w-full max-w-xl rounded-xl px-4 py-3 text-sm font-medium shadow-lg
                  {{ 'bg-emerald-500/15 border border-emerald-500/30 text-emerald-200' if category == 'success'
                     else 'bg-rose-500/15 border border-rose-500/30 text-rose-200' if category == 'error'
                     else 'bg-[--bg-card] border border-[--border-muted] text-[--text-primary]' }}">
        {{ message | e }}
      </div>
      {% endfor %}
    </div>
    {% endif %}
  {% endwith %}

  {# ════════════════════════════════════════════════════════════════════
     MAIN CONTENT
  ════════════════════════════════════════════════════════════════════ #}
  <main id="main-content" class="fade-up">
    {% block content %}{% endblock %}
  </main>

  {# ════════════════════════════════════════════════════════════════════
     FOOTER
  ════════════════════════════════════════════════════════════════════ #}
  <footer class="border-t border-[--border-muted] mt-16 py-6 px-5
                 flex items-center justify-between flex-wrap gap-3">
    <p class="text-xs text-[--text-muted]">
      &copy; {{ now.year if now is defined else "2026" }}
      {{ theme.agency_name }}
      {% if not theme.hide_lokigi_brand %}
        · Tecnología Lokigi
      {% endif %}
    </p>
    {% block footer_links %}{% endblock %}
  </footer>

  {% block scripts %}{% endblock %}
</body>
</html>
